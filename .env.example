# Nixx Studio server settings
SESSION_SECRET=replace-with-a-long-random-value
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Supabase is accessed through the connected Replit integration.
# No Supabase URL or key is required when running through Replit.
# For Vercel, provide the direct project values below instead.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
# Optional fallback for read-only/public setups:
# SUPABASE_ANON_KEY=replace-with-anon-key